+    private fun routePtyInput(bytes: ByteArray, offset: Int, count: Int): Boolean {
+        val activePty = pty ?: return false
+        if ((offset until offset + count).any { bytes[it] == 0x03.toByte() }) {
+            onInterrupt?.invoke()
+        }
+        if (waitingForPastePrompt) {
+            pastedInput.write(bytes, offset, count)
+            return true
+        }
+        val end = offset + count
+        val newline = (offset until end).firstOrNull { bytes[it] == '\r'.code.toByte() || bytes[it] == '\n'.code.toByte() }
+        val isMultilinePaste = newline != null && newline + 1 < end
+        return runCatching {
+            if (isMultilinePaste) {
+                activePty.output.write(bytes, offset, newline - offset + 1)
+                activePty.output.flush()
+                pastedInput.write(bytes, newline + 1, end - newline - 1)
+                waitingForPastePrompt = true
+            } else {
+                activePty.output.write(bytes, offset, count)
+                activePty.output.flush()
+            }
+            true
+        }.getOrDefault(false)
+    }
+
+    private fun releaseNextPastedLine() {
+        if (!waitingForPastePrompt) return
+        waitingForPastePrompt = false
+        val pending = pastedInput.toByteArray()
+        pastedInput.reset()
+        if (pending.isEmpty()) return
+        val newline = pending.indexOfFirst { it == '\r'.code.toByte() || it == '\n'.code.toByte() }
+        val count = if (newline >= 0) newline + 1 else pending.size
+        val activePty = pty ?: return
+        runCatching {
+            activePty.output.write(pending, 0, count)
+            activePty.output.flush()
+        }
+        if (count < pending.size) pastedInput.write(pending, count, pending.size - count)
+        waitingForPastePrompt = newline >= 0
     }
 
