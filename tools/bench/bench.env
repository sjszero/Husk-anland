# Bench configuration. One device, one rootfs, three runners - the runner is the
# only variable.
DEV=${DEV:-UKHMMB8PYTGECMNV}
PKG=${PKG:-com.linuxhub.husk}
BENCH_DIR=${BENCH_DIR:-files/linux/bench}
ROOTFS=${ROOTFS:-files/linux/distributions/ubuntu-24.04/rootfs}
REPS=${REPS:-5}
DISPLAY_NUM=${DISPLAY_NUM:-:0}
