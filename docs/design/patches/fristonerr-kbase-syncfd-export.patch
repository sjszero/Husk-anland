+/* Create a real, potentially pending sync_file for an existing JM atom.
+ *
+ * kbase's STREAM_CREATE ioctl returns a timeline fd.  A soft fence-trigger
+ * atom whose ORDER dependency is the target atom makes the kernel create a
+ * sync_file and write its fd back into base_fence during JOB_SUBMIT.  The
+ * trigger atom is deliberately waiter-less: its completion event only needs
+ * to recycle the atom slot because the sync_file carries the fence.
+ *
+ * The stream fd stays alive for the lifetime of the kbase context.  The
+ * returned sync_file is owned by the caller and must be closed by it.
+ */
+int
+kbase_kmod_create_sync_file_for_atom(struct pan_kmod_dev *dev,
+                                     uint64_t atom_number)
+{
+   struct kbase_kmod_dev *kd = container_of(dev, struct kbase_kmod_dev, base);
+   assert(!kd->is_csf && "JM out-fence export is JM-only");
+
+   if (atom_number == 0 || atom_number > 255) {
+      errno = EINVAL;
+      return -1;
+   }
+
+   simple_mtx_lock(&kd->atoms_lock);
+   if (kd->fence_stream_fd < 0) {
+      struct kbase_ioctl_stream_create stream = {0};
+      snprintf(stream.name, sizeof(stream.name), "husk-panvk");
+      kd->fence_stream_fd =
+         ioctl(dev->fd, KBASE_IOCTL_STREAM_CREATE, &stream);
+      if (kd->fence_stream_fd < 0)
+         mesa_loge("kbase: STREAM_CREATE failed: %s", strerror(errno));
+   }
+   int stream_fd = kd->fence_stream_fd;
+   simple_mtx_unlock(&kd->atoms_lock);
+   if (stream_fd < 0)
+      return -1;
+
+   struct kbase_atom_slot *slot = kbase_atom_alloc(kd, NULL, 0);
+   if (!slot) {
+      errno = ENOMEM;
+      return -1;
+   }
+   const uint8_t trigger_atom = (uint8_t)slot->atom_number;
+
+   /* Nobody waits on the trigger through the atom table.  Setting this before
+    * JOB_SUBMIT also lets a concurrently drained completion event recycle the
+    * slot immediately instead of waiting for a consumer that will never come. */
+   simple_mtx_lock(&kd->atoms_lock);
+   slot->waiters = 0;
+   simple_mtx_unlock(&kd->atoms_lock);
+
+   struct base_fence fence = {
+      .basep = {
+         .fd = -1,
+         .stream_fd = stream_fd,
+      },
+   };
+   struct base_jd_atom atom = {
+      .jc = (uint64_t)(uintptr_t)&fence,
+      .atom_number = trigger_atom,
+      .prio = 0, /* BASE_JD_PRIO_MEDIUM */
+      .device_nr = 0,
+      .core_req = BASE_JD_REQ_SOFT_FENCE_TRIGGER,
+   };
+   atom.pre_dep[0].atom_id = (uint8_t)atom_number;
+   atom.pre_dep[0].dependency_type = BASE_JD_DEP_TYPE_ORDER;
+   g_atom_req[trigger_atom] = BASE_JD_REQ_SOFT_FENCE_TRIGGER;
+
+   struct kbase_ioctl_job_submit sub = {
+      .addr = (uint64_t)(uintptr_t)&atom,
+      .nr_atoms = 1,
+      .stride = kbase_atom_stride(),
+   };
+   if (ioctl(dev->fd, KBASE_IOCTL_JOB_SUBMIT, &sub) < 0) {
+      mesa_loge("kbase: out-fence JOB_SUBMIT dep=%llu err=%d",
+                (unsigned long long)atom_number, errno);
+      simple_mtx_lock(&kd->atoms_lock);
+      if (slot->atom_number == trigger_atom)
+         slot->atom_number = 0;
+      simple_mtx_unlock(&kd->atoms_lock);
+      return -1;
+   }
+
+   if (fence.basep.fd < 0) {
+      mesa_loge("kbase: out-fence trigger did not return a sync_file");
+      errno = ENOENT;
+      return -1;
+   }
+
+   return fence.basep.fd;
+}
