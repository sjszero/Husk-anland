# The CI workflow needs the `workflow` scope on the pushing token. Kept out of
# the tree until that scope is granted, so an ordinary `git add -A` cannot fail
# the release push: add it back with
#   gh auth refresh -h github.com -s workflow && git add -f .github/workflows/ci.yml
.github/workflows/ci.yml

# Build output of `make dist` (the tarball is a release artifact, not a source).
dist/
