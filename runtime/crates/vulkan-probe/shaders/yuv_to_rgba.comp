#version 450

layout(local_size_x = 16, local_size_y = 8) in;

layout(push_constant, std430) uniform Params {
    uint width;
    uint height;
    uint y_offset;
    uint v_offset;
    uint u_offset;
    uint y_stride;
    uint chroma_stride;
    uint output_offset_words;
    uint output_stride_words;
} pc;

layout(std430, binding = 0) readonly buffer YuvInput {
    uint words[];
} input_yuv;

layout(std430, binding = 1) writeonly buffer RgbaOutput {
    uint words[];
} output_rgba;

uint byte_at(uint position) {
    return (input_yuv.words[position >> 2u] >> ((position & 3u) * 8u)) & 0xffu;
}

uint y_byte_at(uint position) {
    return (input_yuv.words[position >> 2u] >> ((position & 3u) * 8u)) & 0xffu;
}

uint clamp_u8(int value) {
    return value <= 0 ? 0u : (value >= 255 ? 255u : uint(value));
}

uint rgba(uint y, uint v, uint u) {
    int c = max(int(y) - 16, 0);
    int d = int(u) - 128;
    int e = int(v) - 128;

    int rv = 298 * c + 409 * e;
    int gv = 298 * c - 100 * d - 208 * e;
    int bv = 298 * c + 516 * d;
    uint r = rv <= 0 ? 0u : clamp_u8((rv + 128) >> 8);
    uint g = gv <= 0 ? 0u : clamp_u8((gv + 128) >> 8);
    uint b = bv <= 0 ? 0u : clamp_u8((bv + 128) >> 8);
    return r | (g << 8u) | (b << 16u) | 0xff000000u;
}

void main() {
    uint x0 = gl_GlobalInvocationID.x * 4u;
    uint y = gl_GlobalInvocationID.y;
    if (x0 >= pc.width || y >= pc.height) {
        return;
    }

    uint chroma_y = y >> 1u;
    uint chroma_x0 = x0 >> 1u;
    uint v0 = byte_at(pc.v_offset + chroma_y * pc.chroma_stride + chroma_x0);
    uint u0 = byte_at(pc.u_offset + chroma_y * pc.chroma_stride + chroma_x0);

    uint out_base = pc.output_offset_words + y * pc.output_stride_words + x0;
    uint y_base = pc.y_offset + y * pc.y_stride + x0;

    if ((x0 & 3u) == 0u && (y_base & 3u) == 0u && (pc.y_stride & 3u) == 0u &&
        x0 + 3u < pc.width && (chroma_x0 & 1u) == 0u &&
        (pc.chroma_stride & 3u) == 0u) {
        uint y_word = input_yuv.words[y_base >> 2u];
        uint v1 = byte_at(pc.v_offset + chroma_y * pc.chroma_stride + chroma_x0 + 1u);
        uint u1 = byte_at(pc.u_offset + chroma_y * pc.chroma_stride + chroma_x0 + 1u);
        output_rgba.words[out_base + 0u] = rgba((y_word >> 0u) & 0xffu, v0, u0);
        output_rgba.words[out_base + 1u] = rgba((y_word >> 8u) & 0xffu, v0, u0);
        output_rgba.words[out_base + 2u] = rgba((y_word >> 16u) & 0xffu, v1, u1);
        output_rgba.words[out_base + 3u] = rgba((y_word >> 24u) & 0xffu, v1, u1);
        return;
    }

    for (uint lane = 0u; lane < 4u; ++lane) {
        uint x = x0 + lane;
        if (x >= pc.width) {
            break;
        }
        uint y_value = y_byte_at(y_base + lane);
        uint v = byte_at(pc.v_offset + chroma_y * pc.chroma_stride + (x >> 1u));
        uint u = byte_at(pc.u_offset + chroma_y * pc.chroma_stride + (x >> 1u));
        output_rgba.words[out_base + lane] = rgba(y_value, v, u);
    }
}
