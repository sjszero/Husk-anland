diff --git a/lorie/src/main/cpp/lorie/husk_native.c b/lorie/src/main/cpp/lorie/husk_native.c
new file mode 100644
index 0000000..72dba66
--- /dev/null
+++ b/lorie/src/main/cpp/lorie/husk_native.c
@@ -0,0 +1,64 @@
+// Husk-native presentation/input bridge for the embedded Xlorie server.
+//
+// This file deliberately contains no Java class lookup. NativeActivity already
+// owns an ANativeWindow, and the guest only needs the Unix X11 socket. Keeping
+// this layer small makes the upstream X server an implementation dependency,
+// not a second Android application/UI.
+#include <android/log.h>
+#include <android/native_window.h>
+#include <stdint.h>
+#include <string.h>
+#include <unistd.h>
+#include "lorie.h"
+
+#define HLOG(...) __android_log_print(ANDROID_LOG_INFO, "HuskXlorie", __VA_ARGS__)
+extern volatile int conn_fd;
+
+static void sendEvent(const lorieEvent* e) {
+    if (!e || conn_fd < 0)
+        return;
+    lorieSocketWriteLock();
+    (void)lorieSocketWriteAll(conn_fd, e, sizeof(*e));
+    lorieSocketWriteUnlock();
+}
+
+void husk_xlorie_set_window(ANativeWindow* window, int width, int height) {
+    HLOG("set_window win=%p size=%dx%d", window, width, height);
+    rendererSetNativeWindow(window, width, height);
+}
+
+void husk_xlorie_send_window_size(int width, int height, int framerate, const char* name) {
+    // Send from the activity side of the socket pair. See
+    // lorieSendScreenSizeNative() for the direction invariant.
+    lorieSendScreenSizeNative(width, height, framerate, name);
+    HLOG("queue_window_size %dx%d@%d", width, height, framerate);
+}
+
+void husk_xlorie_send_touch(int action, int id, int x, int y) {
+    if (conn_fd < 0)
+        return;
+    lorieEvent e = { .touch = {
+        .t = EVENT_TOUCH, .type = (uint16_t)action, .id = (uint16_t)id,
+        .x = (uint16_t)x, .y = (uint16_t)y,
+    }};
+    sendEvent(&e);
+}
+
+void husk_xlorie_send_mouse(float x, float y, int button, int down, int relative) {
+    if (conn_fd < 0)
+        return;
+    lorieEvent e = { .mouse = {
+        .t = EVENT_MOUSE, .x = x, .y = y, .detail = (uint8_t)button,
+        .down = (uint8_t)down, .relative = (uint8_t)relative,
+    }};
+    sendEvent(&e);
+}
+
+void husk_xlorie_send_key(int linux_keycode, int down) {
+    if (conn_fd < 0 || linux_keycode <= 0)
+        return;
+    lorieEvent e = { .key = {
+        .t = EVENT_KEY, .key = (uint16_t)(linux_keycode + 8), .state = (uint8_t)down,
+    }};
+    sendEvent(&e);
+}
