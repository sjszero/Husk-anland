+    if ((pixels[0] & 0xffffff) != 0x332211) {
+        loge("CPU mapping does not see GPU writes (got %08x)", pixels[0]);
+        AHardwareBuffer_unlock(buf, nullptr);
+        result = false;
+        goto out;
+    }
+
+    // Unlocking must not bring back stale CPU data over what the GPU has written.
+    AHardwareBuffer_unlock(buf, nullptr);
